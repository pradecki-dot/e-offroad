# e-offroad.com — Apache
DirectoryIndex index.html
ErrorDocument 404 /404.html

# 301 — stare adresy po zmianie struktury kategorii (listopad 2026)
<IfModule mod_alias.c>
  RedirectMatch 301 ^/e-enduro(/.*)?$ /motocykle-elektryczne-terenowe/cross-i-enduro/
  RedirectMatch 301 ^/hard-enduro-elektryczny(/.*)?$ /motocykle-elektryczne-terenowe/cross-i-enduro/
  # scalenie Cross + Enduro -> Cross i Enduro (listopad 2026), wszystkie wersje językowe
  RedirectMatch 301 ^/(en/|de/|fr/|zh/)?motocykle-elektryczne-terenowe/(cross|enduro)/?(index\.html)?$ /$1motocykle-elektryczne-terenowe/cross-i-enduro/
  RedirectMatch 301 ^/quady-elektryczne(/.*)?$ /quady-atv/quady/
  RedirectMatch 301 ^/quad-enduro-elektryczny(/.*)?$ /quady-atv/quady/
  RedirectMatch 301 ^/motocykle-elektryczne-dla-dzieci(/.*)?$ /motocykle-elektryczne-terenowe/dla-dzieci/
</IfModule>
AddDefaultCharset UTF-8
AddType image/svg+xml .svg
AddType image/webp .webp
AddType application/manifest+json .webmanifest

# /api/kursy.php — dzienne kursy NBP (PHP), ustawienia w /api/.htaccess

# Wymuszenie HTTPS i domeny bez www (odkomentuj po podpięciu SSL)
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://e-offroad.com%{REQUEST_URI} [L,R=301]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/xml text/plain application/ld+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
